    "@babel/preset-react": "7.29.7",
    "babel-loader": "10.1.1",
    "html-webpack-plugin": "5.6.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
